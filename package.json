{
  "name": "smooth-vuebar",
  "version": "2.0.2",
  "description": "Vue 3 directive wrapper for smooth-scrollbar",
  "type": "module",
  "main": "./dist/smooth-vuebar.cjs",
  "module": "./dist/smooth-vuebar.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/smooth-vuebar.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/smooth-vuebar.cjs"
      }
    },
    "./default.css": "./src/default.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/default.css"
  ],
  "sideEffects": [
    "src/default.css"
  ],
  "scripts": {
    "build": "vite build",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.test.json && npm run typecheck-demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build && npm run lint:package",
    "build-demo": "vite build --config vite.config.demo.ts",
    "dev-demo": "vite --config vite.config.demo.ts",
    "typecheck-demo": "vue-tsc --noEmit -p tsconfig.demo.json",
    "lint:package": "publint --strict && attw --pack . --exclude-entrypoints ./default.css"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "smooth-scrollbar": "^8.8.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.6.0",
    "jsdom": "^30.0.1",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scaccogatto/smooth-vuebar.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "smooth",
    "smooth-scroll",
    "scrollbar",
    "custom-scrollbar",
    "directive",
    "plugin",
    "typescript",
    "vite"
  ],
  "author": "Marco 'Gatto' Boffo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/scaccogatto/smooth-vuebar/issues"
  },
  "homepage": "https://scaccogatto.github.io/smooth-vuebar/"
}
